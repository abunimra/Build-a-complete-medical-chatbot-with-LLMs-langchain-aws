        "\n",
        "class DataAugmentor:\n",
        "    \"\"\"Data augmentation for training\"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        self.synonym_aug = None\n",
        "        if NLPAUG_AVAILABLE:\n",
        "            try:\n",
        "                self.synonym_aug = naw.SynonymAug(aug_src='wordnet')\n",
        "            except:\n",
        "                pass\n",
        "\n",
        "    def augment_variant(self, text: str) -> List[str]:\n",
        "        if not text or len(text.split()) < 3 or self.synonym_aug is None:\n",
        "            return [text]\n",
        "\n",
        "        augmented = [text]\n",
        "        try:\n",
        "            for _ in range(2):\n",
        "                aug_text = self.synonym_aug.augment(text)\n",
        "                if aug_text and aug_text != text:\n",
        "                    augmented.append(aug_text)\n",
        "        except:\n",
        "            pass\n",
        "        return list(dict.fromkeys(augmented))\n",
        "\n",
        "    def augment_dataset(self, df: pd.DataFrame) -> pd.DataFrame:\n",
        "        if self.synonym_aug is None:\n",
        "            return df\n",
        "\n",
        "        augmented_rows = []\n",
        "        for _, row in tqdm(df.iterrows(), total=len(df), desc=\"Augmenting\"):\n",
        "            augmented_rows.append(row.to_dict())\n",
        "            for variant_type in ['technical', 'accessible', 'catchy']:\n",
        "                variant = row.get(variant_type, '')\n",
        "                if variant and len(variant) > 10:\n",
        "                    aug_variants = self.augment_variant(variant)\n",
        "                    for aug_v in aug_variants:\n",
        "                        if aug_v != variant and aug_v:\n",
        "                            new_row = row.to_dict()\n",
        "                            new_row[variant_type] = aug_v\n",
        "                            new_row['augmented'] = True\n",
        "                            augmented_rows.append(new_row)\n",
        "        return pd.DataFrame(augmented_rows)\n",
        "\n",
        "print(\"✅ DataAugmentor ready!\")\n",
