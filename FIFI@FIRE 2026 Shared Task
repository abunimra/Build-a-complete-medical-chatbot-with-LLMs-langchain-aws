        "# CELL 3: PREPROCESSOR\n",
        "# ============================================================================\n",
        "\n",
        "class SmartPreprocessor:\n",
        "    \"\"\"Smart text preprocessing with stopword handling\"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        try:\n",
        "            self.stopwords = set(stopwords.words('english'))\n",
        "        except:\n",
        "            self.stopwords = set(['the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for'])\n",
        "\n",
        "    def clean(self, text: Any) -> str:\n",
        "        if text is None or pd.isna(text):\n",
        "            return \"\"\n",
        "        text = str(text).lower()\n",
        "        text = re.sub(r'[^a-zA-Z0-9\\s\\-\\.]', ' ', text)\n",
        "        text = re.sub(r'\\s+', ' ', text).strip()\n",
        "        return text\n",
        "\n",
        "    def tokenize(self, text: Any) -> List[str]:\n",
        "        text = self.clean(text)\n",
        "        if not text:\n",
        "            return []\n",
        "        try:\n",
        "            return word_tokenize(text.lower())\n",
        "        except:\n",
        "            return text.lower().split()\n",
        "\n",
        "    def preprocess(self, text: Any) -> str:\n",
        "        text = self.clean(text)\n",
        "        if not text:\n",
        "            return \"\"\n",
        "        tokens = self.tokenize(text)\n",
        "        tokens = [t for t in tokens if t not in self.stopwords and len(t) > 2]\n",
        "        return ' '.join(tokens) if tokens else text\n",
        "\n",
        "print(\"✅ SmartPreprocessor ready!\")\n",
        "\n",
