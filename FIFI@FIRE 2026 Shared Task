        "# CELL 5: FIXED RETRIEVER - NO 'fuzzy' KEY ERROR\n",
        "# ============================================================================\n",
        "\n",
        "class FixedRetriever:\n",
        "    \"\"\"\n",
        "    FIXED Retriever - properly handles all weights including 'fuzzy'\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        self.titles = None\n",
        "        self.preprocessor = None\n",
        "        self.vectorizer = None\n",
        "        self.tfidf_vectors = None\n",
        "        self.bm25 = None\n",
        "        self.sbert = None\n",
        "        self.embeddings = None\n",
        "        self.available = True\n",
        "        # CRITICAL FIX: Always include 'fuzzy' in weights\n",
        "        self.weights = {'tfidf': 0.25, 'bm25': 0.15, 'sbert': 0.40, 'fuzzy': 0.20}\n",
        "\n",
        "    def fit(self, titles: List[str], preprocessor: SmartPreprocessor):\n",
        "        self.titles = titles\n",
        "        self.preprocessor = preprocessor\n",
        "\n",
        "        valid_titles = [t for t in titles if t and str(t).strip()]\n",
        "        self.titles = valid_titles\n",
        "        print(f\"  📊 Fitting on {len(self.titles)} titles...\")\n",
        "\n",
        "        # TF-IDF\n",
        "        print(\"  Building TF-IDF...\")\n",
        "        self.vectorizer = TfidfVectorizer(max_features=15000, ngram_range=(1, 3), min_df=3)\n",
        "        self.vectorizer.fit(self.titles)\n",
        "        self.tfidf_vectors = self.vectorizer.transform(self.titles)\n",
        "\n",
        "        # BM25\n",
        "        print(\"  Building BM25...\")\n",
        "        tokenized = [preprocessor.tokenize(t) for t in self.titles]\n",
        "        self.bm25 = BM25Okapi(tokenized)\n",
        "\n",
        "        # SBERT\n",
        "        print(\"  Building SBERT...\")\n",
        "        try:\n",
        "            self.sbert = SentenceTransformer('all-MiniLM-L6-v2')\n",
        "            if torch.cuda.is_available():\n",
        "                self.sbert = self.sbert.to('cuda')\n",
        "            self.embeddings = self.sbert.encode(\n",
        "                self.titles,\n",
        "                show_progress_bar=True,\n",
        "                convert_to_numpy=True,\n",
        "                batch_size=64\n",
        "            )\n",
        "            print(f\"  ✅ SBERT loaded: {self.embeddings.shape}\")\n",
        "        except Exception as e:\n",
        "            print(f\"  ⚠️ SBERT failed: {e}\")\n",
        "            self.sbert = None\n",
        "            self.embeddings = None\n",
        "\n",
        "        print(\"  ✅ All models ready!\")\n",
        "\n",
        "    def retrieve(self, query: str, top_k: int = 100) -> List[Tuple[str, float]]:\n",
        "        \"\"\"\n",
        "        FIXED: Safe retrieval with proper key handling\n",
        "        \"\"\"\n",
        "        if not self.available or not query or not self.titles:\n",
        "            return []\n",
        "\n",
        "        query_processed = self.preprocessor.preprocess(query)\n",
        "        query_tokens = self.preprocessor.tokenize(query)\n",
        "\n",
        "        if not query_processed:\n",
        "            return []\n",
        "\n",
        "        results = defaultdict(float)\n",
        "\n",
        "        try:\n",
        "            # TF-IDF\n",
        "            query_vec = self.vectorizer.transform([query_processed])\n",
        "            tfidf_scores = cosine_similarity(query_vec, self.tfidf_vectors).flatten()\n",
        "\n",
        "            # BM25\n",
        "            bm25_scores = np.array(self.bm25.get_scores(query_tokens))\n",
        "            if bm25_scores.max() > 0:\n",
        "                bm25_scores = bm25_scores / bm25_scores.max()\n",
        "\n",
        "            # SBERT\n",
        "            sbert_scores = None\n",
        "            if self.sbert is not None and self.embeddings is not None:\n",
        "                query_emb = self.sbert.encode([query], convert_to_numpy=True)\n",
        "                sbert_scores = cosine_similarity(query_emb, self.embeddings).flatten()\n",
        "\n",
        "            # CRITICAL FIX: Safe key access with .get()\n",
        "            tfidf_w = self.weights.get('tfidf', 0.25)\n",
        "            bm25_w = self.weights.get('bm25', 0.15)\n",
        "            sbert_w = self.weights.get('sbert', 0.40)\n",
        "            fuzzy_w = self.weights.get('fuzzy', 0.20)\n",
        "\n",
        "            # Fuzzy scores\n",
        "            fuzzy_scores = np.array([fuzz.ratio(query.lower(), t.lower()) / 100.0 for t in self.titles])\n",
        "\n",
        "            # Combine\n",
        "            for idx in range(len(self.titles)):\n",
        "                combined = (\n",
        "                    tfidf_w * tfidf_scores[idx] +\n",
        "                    bm25_w * bm25_scores[idx] +\n",
        "                    fuzzy_w * fuzzy_scores[idx]\n",
        "                )\n",
        "                if sbert_scores is not None:\n",
        "                    combined += sbert_w * sbert_scores[idx]\n",
        "                results[self.titles[idx]] = combined\n",
        "\n",
        "            sorted_results = sorted(results.items(), key=lambda x: x[1], reverse=True)\n",
        "            return sorted_results[:top_k]\n",
        "\n",
        "        except Exception as e:\n",
        "            logger.error(f\"Retrieval error: {e}\")\n",
        "            return []\n",
        "\n",
        "print(\"✅ FixedRetriever ready!\")\n",
        "\n",
        "# ============================================================================\n",
        "# CELL 6: RERANKER\n",
        "# ============================================================================\n",
        "\n",
        "class FastReranker:\n",
        "    \"\"\"Fast reranker with cross-encoder\"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        self.model = None\n",
        "        self.available = False\n",
        "        self.cache = {}\n",
        "\n",
        "    def load(self):\n",
        "        try:\n",
        "            print(\"  Loading cross-encoder...\")\n",
        "            self.model = CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')\n",
        "            if torch.cuda.is_available():\n",
        "                self.model.model = self.model.model.to('cuda')\n",
        "                self.model.model = self.model.model.half()\n",
        "            self.available = True\n",
        "            print(\"  ✅ Cross-encoder loaded\")\n",
        "        except:\n",
        "            print(\"  ⚠️ Cross-encoder failed\")\n",
        "            self.available = False\n",
        "\n",
        "    def rerank(self, query: str, candidates: List[Tuple[str, float]], top_k: int = 10) -> List[Tuple[str, float]]:\n",
        "        if not candidates or not self.available or self.model is None:\n",
        "            return candidates[:top_k] if candidates else []\n",
        "\n",
        "        cache_key = f\"{query[:50]}_{len(candidates)}\"\n",
        "        if cache_key in self.cache:\n",
        "            return self.cache[cache_key]\n",
        "\n",
        "        try:\n",
        "            limit = min(50, len(candidates))\n",
        "            pairs = [[query, title] for title, _ in candidates[:limit]]\n",
        "            scores = self.model.predict(pairs, convert_to_tensor=False)\n",
        "            if isinstance(scores, torch.Tensor):\n",
        "                scores = scores.cpu().numpy()\n",
        "\n",
        "            reranked = []\n",
        "            for (title, orig_score), ce_score in zip(candidates[:limit], scores):\n",
        "                norm_orig = orig_score / 10.0 if orig_score > 0 else 0\n",
        "                norm_ce = ce_score\n",
        "                combined = 0.4 * norm_orig + 0.6 * norm_ce\n",
        "                reranked.append((title, combined))\n",
        "\n",
        "            reranked.sort(key=lambda x: x[1], reverse=True)\n",
        "            result = reranked[:top_k]\n",
        "            self.cache[cache_key] = result\n",
        "\n",
        "            if len(self.cache) > 500:\n",
        "                self.cache.clear()\n",
        "                gc.collect()\n",
        "\n",
        "            return result\n",
        "        except:\n",
        "            return candidates[:top_k]\n",
        "\n",
        "print(\"✅ FastReranker ready!\")\n",
        "\n",
        "# ============================================================================\n",
        "# CELL 7: CONFIDENCE CALIBRATOR\n",
        "# ============================================================================\n",
        "\n",
        "class ConfidenceCalibrator:\n",
        "    def __init__(self):\n",
        "        self.calibrator = None\n",
        "\n",
        "    def fit(self, pipeline, val_df: pd.DataFrame):\n",
        "        X_val, y_val = [], []\n",
        "        sample = val_df.sample(n=min(300, len(val_df)), random_state=42)\n",
        "\n",
        "        for _, row in tqdm(sample.iterrows(), total=len(sample), desc=\"Calibrating\"):\n",
        "            original = row.get('original_title', '')\n",
        "            if not original:\n",
        "                continue\n",
        "            for variant_type in ['technical', 'accessible', 'catchy']:\n",
        "                variant = row.get(variant_type, '')\n",
        "                if variant and str(variant).strip():\n",
        "                    pred = pipeline.predict(variant)\n",
        "                    if pred['confidence'] > 0:\n",
        "                        X_val.append([pred['confidence']])\n",
        "                        y_val.append(1 if pred['predicted_title'] == original else 0)\n",
        "\n",
        "        if X_val and y_val:\n",
        "            try:\n",
        "                self.calibrator = IsotonicRegression(out_of_bounds='clip')\n",
        "                self.calibrator.fit(np.array(X_val).flatten(), np.array(y_val))\n",
        "                print(f\"✅ Calibrator trained on {len(X_val)} samples\")\n",
        "            except Exception as e:\n",
        "                print(f\"⚠️ Calibration failed: {e}\")\n",
        "\n",
        "    def calibrate(self, confidence: float) -> float:\n",
        "        if self.calibrator is None or confidence <= 0:\n",
        "            return confidence\n",
        "        try:\n",
        "            return float(self.calibrator.predict([[confidence]])[0])\n",
        "        except:\n",
        "            return confidence\n",
        "\n",
        "print(\"✅ ConfidenceCalibrator ready!\")\n",
        "\n",
        "# ============================================================================\n",
        "# CELL 8: EXCELLENT PIPELINE\n",
        "# ============================================================================\n",
        "\n",
        "class ExcellentFIFIPipeline:\n",
        "    \"\"\"Complete Excellent FIFI Pipeline - All Fixes Applied\"\"\"\n",
        "\n",
        "    def __init__(self):\n",
        "        self.preprocessor = SmartPreprocessor()\n",
        "        self.retriever = None\n",
        "        self.reranker = FastReranker()\n",
        "        self.calibrator = ConfidenceCalibrator()\n",
        "        self.results = {'metrics': {}, 'predictions': []}\n",
        "        self.is_ready = False\n",
        "        self.prediction_cache = {}\n",
        "\n",
        "    def train(self, train_data: pd.DataFrame, val_data: pd.DataFrame = None, use_augmentation: bool = True):\n",
        "        \"\"\"Train the pipeline\"\"\"\n",
        "        print(\"\\n\" + \"=\"*60)\n",
        "        print(\"🏋️ TRAINING PIPELINE\")\n",
        "        print(\"=\"*60)\n",
        "\n",
        "        # 1. Data Augmentation\n",
        "        if use_augmentation:\n",
        "            print(\"\\n🔧 1. Data Augmentation...\")\n",
        "            augmentor = DataAugmentor()\n",
        "            train_aug = augmentor.augment_dataset(train_data)\n",
        "            print(f\"   Augmented: {len(train_aug):,} samples\")\n",
        "        else:\n",
        "            train_aug = train_data\n",
        "\n",
        "        # 2. Train retriever\n",
        "        print(\"\\n🔧 2. Training Retriever...\")\n",
        "        titles = train_aug['original_title'].astype(str).tolist()\n",
        "        self.retriever = FixedRetriever()\n",
        "        self.retriever.fit(titles, self.preprocessor)\n",
        "\n",
        "        # 3. Load reranker\n",
        "        print(\"\\n🔧 3. Loading Reranker...\")\n",
        "        self.reranker.load()\n",
        "\n",
        "        # 4. Optimize weights (if optuna available)\n",
        "        if val_data is not None and len(val_data) > 0 and OPTUNA_AVAILABLE:\n",
        "            print(\"\\n🔧 4. Optimizing weights...\")\n",
        "            best_weights = self._optimize_weights(val_data)\n",
        "            if best_weights:\n",
        "                # CRITICAL: Ensure 'fuzzy' is in weights\n",
        "                if 'fuzzy' not in best_weights:\n",
        "                    best_weights['fuzzy'] = 0.15\n",
        "                self.retriever.weights = best_weights\n",
        "                print(f\"   Optimized: {best_weights}\")\n",
        "\n",
        "        # 5. Calibrate confidence\n",
        "        if val_data is not None and len(val_data) > 0:\n",
        "            print(\"\\n🔧 5. Calibrating confidence...\")\n",
        "            self.calibrator.fit(self, val_data)\n",
        "\n",
        "        self.is_ready = True\n",
        "        print(\"\\n✅ Training complete!\")\n",
        "\n",
        "    def _optimize_weights(self, val_data: pd.DataFrame) -> Dict[str, float]:\n",
        "        \"\"\"Optimize ensemble weights\"\"\"\n",
        "        if not OPTUNA_AVAILABLE:\n",
        "            return None\n",
        "\n",
        "        def objective(trial):\n",
        "            w1 = trial.suggest_float('tfidf', 0.05, 0.5)\n",
        "            w2 = trial.suggest_float('bm25', 0.05, 0.4)\n",
        "            w3 = trial.suggest_float('sbert', 0.1, 0.7)\n",
        "            w4 = 1.0 - w1 - w2 - w3\n",
        "            if w4 < 0:\n",
        "                return 0.0\n",
        "            # Always include fuzzy\n",
        "            self.retriever.weights = {'tfidf': w1, 'bm25': w2, 'sbert': w3, 'fuzzy': w4}\n",
        "            sample = val_data.sample(n=min(200, len(val_data)), random_state=42)\n",
        "            metrics = self.evaluate(sample)\n",
        "            return metrics.get('overall', {}).get('accuracy', 0.0)\n",
        "\n",
        "        try:\n",
        "            study = optuna.create_study(direction='maximize')\n",
        "            study.optimize(objective, n_trials=10, show_progress_bar=True)\n",
        "            best = study.best_params\n",
        "            # Ensure fuzzy is included\n",
        "            if 'fuzzy' not in best:\n",
        "                best['fuzzy'] = 0.15\n",
        "            print(f\"   Best accuracy: {study.best_value:.4f}\")\n",
        "            return best\n",
        "        except Exception as e:\n",
        "            print(f\"⚠️ Optimization failed: {e}\")\n",
        "            return None\n",
        "\n",
        "    def predict(self, variant: str, top_k: int = 100) -> Dict:\n",
        "        \"\"\"Predict original title\"\"\"\n",
        "        if not self.is_ready or not variant:\n",
        "            return {'predicted_title': '', 'confidence': 0.0, 'candidates': []}\n",
        "\n",
        "        variant_str = str(variant).strip()\n",
        "        if not variant_str:\n",
        "            return {'predicted_title': '', 'confidence': 0.0, 'candidates': []}\n",
        "\n",
        "        # Check cache\n",
        "        if variant_str in self.prediction_cache:\n",
        "            return self.prediction_cache[variant_str]\n",
        "\n",
        "        # Retrieve\n",
        "        candidates = self.retriever.retrieve(variant_str, top_k=100)\n",
        "        if not candidates:\n",
        "            return {'predicted_title': '', 'confidence': 0.0, 'candidates': []}\n",
        "\n",
        "        # Rerank\n",
        "        reranked = self.reranker.rerank(variant_str, candidates, top_k=100)\n",
        "\n",
        "        if reranked:\n",
        "            predicted = reranked[0][0]\n",
        "            confidence = reranked[0][1]\n",
        "            calibrated = self.calibrator.calibrate(confidence)\n",
        "\n",
        "            result = {\n",
        "                'predicted_title': predicted,\n",
        "                'confidence': confidence,\n",
        "                'calibrated_confidence': calibrated,\n",
        "                'candidates': reranked[:100]\n",
        "            }\n",
        "\n",
        "            # Cache\n",
        "            self.prediction_cache[variant_str] = result\n",
        "            if len(self.prediction_cache) > 500:\n",
        "                keys = list(self.prediction_cache.keys())[:250]\n",
        "                for k in keys:\n",
        "                    del self.prediction_cache[k]\n",
        "                gc.collect()\n",
        "\n",
        "            return result\n",
        "\n",
        "        return {'predicted_title': '', 'confidence': 0.0, 'candidates': []}\n",
        "\n",
        "    def evaluate(self, test_data: pd.DataFrame, max_samples: int = None) -> Dict:\n",
        "        \"\"\"Evaluate on validation data\"\"\"\n",
        "        if test_data is None or len(test_data) == 0:\n",
        "            return {'overall': {'accuracy': 0, 'mrr': 0, 'total_samples': 0, 'correct_count': 0}}\n",
        "\n",
        "        if max_samples and len(test_data) > max_samples:\n",
        "            test_data = test_data.sample(n=max_samples, random_state=42)\n",
        "\n",
        "        # Clean data\n",
        "        for col in ['original_title', 'technical', 'accessible', 'catchy']:\n",
        "            if col in test_data.columns:\n",
        "                test_data[col] = test_data[col].astype(str).str.strip()\n",
        "\n",
        "        if 'original_title' in test_data.columns:\n",
        "            test_data = test_data[test_data['original_title'] != '']\n",
        "\n",
        "        if len(test_data) == 0:\n",
        "            return {'overall': {'accuracy': 0, 'mrr': 0, 'total_samples': 0, 'correct_count': 0}}\n",
        "\n",
        "        metrics = {\n",
        "            'technical': {'correct': 0, 'mrr_sum': 0, 'count': 0},\n",
        "            'accessible': {'correct': 0, 'mrr_sum': 0, 'count': 0},\n",
        "            'catchy': {'correct': 0, 'mrr_sum': 0, 'count': 0}\n",
        "        }\n",
        "\n",
        "        predictions = []\n",
        "\n",
        "        for _, row in tqdm(test_data.iterrows(), total=len(test_data), desc=\"Evaluating\"):\n",
        "            original = row.get('original_title', '').strip()\n",
        "            if not original:\n",
        "                continue\n",
        "\n",
        "            for variant_type in ['technical', 'accessible', 'catchy']:\n",
        "                variant = row.get(variant_type, '').strip()\n",
        "                if not variant:\n",
        "                    continue\n",
        "\n",
        "                pred = self.predict(variant)\n",
        "                predicted = pred.get('predicted_title', '')\n",
        "                candidates = [c[0] for c in pred.get('candidates', [])]\n",
        "\n",
        "                correct = False\n",
        "                mrr = 0.0\n",
        "                rank = None\n",
        "\n",
        "                if predicted == original:\n",
        "                    correct = True\n",
        "                    mrr = 1.0\n",
        "                    rank = 1\n",
        "                elif original in candidates:\n",
        "                    rank = candidates.index(original) + 1\n",
        "                    mrr = 1.0 / rank\n",
        "                    correct = True\n",
        "                else:\n",
        "                    for i, cand in enumerate(candidates[:10]):\n",
        "                        if fuzz.ratio(cand.lower(), original.lower()) > 85:\n",
        "                            correct = True\n",
        "                            rank = i + 1\n",
        "                            mrr = 1.0 / rank\n",
        "                            break\n",
        "\n",
        "                m = metrics[variant_type]\n",
        "                m['count'] += 1\n",
        "                if correct:\n",
        "                    m['correct'] += 1\n",
        "                    m['mrr_sum'] += mrr\n",
        "\n",
        "                predictions.append({\n",
        "                    'original': original[:50] + '...' if len(original) > 50 else original,\n",
        "                    'variant_type': variant_type,\n",
        "                    'predicted': predicted[:50] + '...' if len(predicted) > 50 else predicted,\n",
        "                    'correct': correct,\n",
        "                    'rank': rank\n",
        "                })\n",
        "\n",
        "        # Calculate results\n",
        "        final_metrics = {}\n",
        "        total_correct = 0\n",
        "        total_samples = 0\n",
        "        total_mrr = 0\n",
        "\n",
        "        for variant_type in ['technical', 'accessible', 'catchy']:\n",
        "            m = metrics[variant_type]\n",
        "            if m['count'] > 0:\n",
        "                acc = m['correct'] / m['count']\n",
        "                mrr = m['mrr_sum'] / m['count']\n",
        "                final_metrics[variant_type] = {\n",
        "                    'accuracy': acc,\n",
        "                    'mrr': mrr,\n",
        "                    'count': m['count'],\n",
        "                    'correct': m['correct']\n",
        "                }\n",
        "                total_correct += m['correct']\n",
        "                total_samples += m['count']\n",
        "                total_mrr += mrr\n",
        "\n",
        "        final_metrics['overall'] = {\n",
        "            'accuracy': total_correct / total_samples if total_samples > 0 else 0,\n",
        "            'mrr': total_mrr / 3 if total_samples > 0 else 0,\n",
        "            'total_samples': total_samples,\n",
        "            'correct_count': total_correct\n",
        "        }\n",
        "\n",
        "        self.results['metrics'] = final_metrics\n",
        "        self.results['predictions'] = predictions\n",
        "\n",
        "        return final_metrics\n",
        "\n",
        "    def display_results(self):\n",
        "        \"\"\"Display results\"\"\"\n",
        "        print(\"\\n\" + \"=\"*60)\n",
        "        print(\"📊 EVALUATION RESULTS\")\n",
        "        print(\"=\"*60)\n",
        "\n",
        "        metrics = self.results['metrics']\n",
        "\n",
        "        for variant_type in ['technical', 'accessible', 'catchy']:\n",
        "            m = metrics.get(variant_type, {})\n",
        "            if m.get('count', 0) > 0:\n",
        "                print(f\"\\n{variant_type.upper()}:\")\n",
        "                print(f\"  Accuracy: {m['accuracy']:.4f} ({m['accuracy']*100:.2f}%)\")\n",
        "                print(f\"  MRR: {m['mrr']:.4f}\")\n",
        "                print(f\"  Correct: {m['correct']}/{m['count']}\")\n",
        "\n",
        "        overall = metrics.get('overall', {})\n",
        "        print(f\"\\n📈 OVERALL:\")\n",
        "        print(f\"  Accuracy: {overall.get('accuracy', 0):.4f} ({overall.get('accuracy', 0)*100:.2f}%)\")\n",
        "        print(f\"  MRR: {overall.get('mrr', 0):.4f}\")\n",
        "        print(f\"  Total: {overall.get('correct_count', 0)}/{overall.get('total_samples', 0)}\")\n",
        "\n",
        "        print(\"\\n🔍 Sample Predictions:\")\n",
        "        for i, pred in enumerate(self.results['predictions'][:5]):\n",
        "            status = \"✅\" if pred['correct'] else \"❌\"\n",
        "            print(f\"\\n  {status} {pred['variant_type']}:\")\n",
        "            print(f\"    Original: {pred['original']}\")\n",
        "            print(f\"    Predicted: {pred['predicted']}\")\n",
        "            if pred.get('rank'):\n",
        "                print(f\"    Rank: {pred['rank']}\")\n",
        "\n",
        "    def generate_submission(self, test_data: Dict[str, pd.DataFrame], output_file: str = 'submission.csv'):\n",
        "        \"\"\"Generate submission\"\"\"\n",
        "        print(\"\\n📝 Generating submission...\")\n",
        "        submissions = []\n",
        "\n",
        "        for file_name, df in test_data.items():\n",
        "            for _, row in tqdm(df.iterrows(), total=len(df), desc=f\"Processing {file_name}\"):\n",
        "                row_id = row.get('id', f'sample_{len(submissions)}')\n",
        "                for variant_type in ['technical', 'accessible', 'catchy']:\n",
        "                    variant = row.get(variant_type, '')\n",
        "                    if variant and str(variant).strip():\n",
        "                        pred = self.predict(str(variant), top_k=100)\n",
        "                        candidates = pred.get('candidates', [])\n",
        "                        for rank, (title, score) in enumerate(candidates[:100], 1):\n",
        "                            submissions.append({\n",
        "                                'id': row_id,\n",
        "                                'variant_type': variant_type,\n",
        "                                'candidate_rank': rank,\n",
        "                                'predicted_title': title,\n",
        "                                'confidence': score,\n",
        "                                'calibrated_confidence': pred.get('calibrated_confidence', score)\n",
        "                            })\n",
        "\n",
        "        submission_df = pd.DataFrame(submissions)\n",
        "        submission_df.to_csv(output_file, index=False)\n",
        "        print(f\"✅ Submission saved: {len(submission_df)} predictions\")\n",
        "        print(f\"   Unique IDs: {submission_df['id'].nunique()}\")\n",
        "        print(f\"   Variant types: {submission_df['variant_type'].unique().tolist()}\")\n",
